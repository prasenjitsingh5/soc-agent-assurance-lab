# Copy to .env and fill in only what you use. Never commit .env.
# The default configuration runs with the deterministic mock provider and needs no keys.

SOCLAB_PROVIDER=mock
SOCLAB_MODEL=mock-investigator-v1
# Same default as the CLI and the API. The runs directory is created on first use.
SOCLAB_DATABASE_URL=sqlite+pysqlite:///./runs/soclab.sqlite
# Either a running OPA server or a binary the lab can launch. Leave both unset
# to use the binary from `soclab opa install` or from PATH.
SOCLAB_OPA_URL=http://localhost:8181
SOCLAB_OPA_BINARY=
# Optional. At least 32 bytes when set. Unset means a fresh random key per process,
# which is correct when the gateway and the executor share one process.
SOCLAB_GRANT_SIGNING_KEY=

# Bring your own agent over HTTP (provider id `http`). See docs/custom-provider.md.
SOCLAB_HTTP_AGENT_URL=
SOCLAB_HTTP_AGENT_TOKEN=
SOCLAB_HTTP_AGENT_TIMEOUT_SECONDS=30

# Optional provider credentials. Leave blank to keep the provider unavailable.
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
XAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
